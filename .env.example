# Copy this file to `.env` and fill in real values.
# NEVER commit real secrets. `.env` is gitignored.

# Runtime
NODE_ENV=development
# Default 3000 matches the frontend dev apiUrl. Deploy hosts set PORT automatically.
PORT=3000

# PostgreSQL (either DATABASE_URL OR the DB_* fields)
# On Railway: DATABASE_URL is injected automatically.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=ims
# Set to false once you add real migrations (recommended for production).
DB_SYNC=true

# Auth
# Use a long random string in production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS - comma-separated list of allowed frontend origins.
# If empty, ANY origin is reflected (recommended default for this app).
# Example: CORS_ORIGIN=https://ims-frontend.up.railway.app
CORS_ORIGIN=
